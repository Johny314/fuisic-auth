{
    "name": "fuisic/auth",
    "description": "Reusable Laravel authentication with OAuth, email verification, passkeys and RabbitMQ",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "auth", "sanctum", "oauth", "webauthn", "passkeys", "rabbitmq"],
    "authors": [
        {
            "name": "FUISIC",
            "homepage": "https://github.com/Johny314/fuisic-auth"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^11.0",
        "illuminate/console": "^11.0",
        "illuminate/database": "^11.0",
        "illuminate/http": "^11.0",
        "illuminate/notifications": "^11.0",
        "illuminate/routing": "^11.0",
        "illuminate/support": "^11.0",
        "laragear/webauthn": "^4.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.0",
        "socialiteproviders/manager": "^4.6",
        "socialiteproviders/vkontakte": "^5.0",
        "socialiteproviders/yandex": "^4.0",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "Fuisic\\Auth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fuisic\\Auth\\FuisicAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
