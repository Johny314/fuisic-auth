{
    "name": "fuisic/auth",
    "description": "Reusable Laravel authentication with OAuth, email verification, passkeys and RabbitMQ",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "auth",
        "sanctum",
        "oauth",
        "webauthn",
        "passkeys",
        "rabbitmq"
    ],
    "authors": [
        {
            "name": "FUISIC",
            "homepage": "https://github.com/Johny314/fuisic-auth"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/passkeys": "^0.2.1",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.20",
        "socialiteproviders/manager": "^4.10",
        "socialiteproviders/vkontakte": "^5.1",
        "socialiteproviders/yandex": "^4.2",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^15.0"
    },
    "autoload": {
        "psr-4": {
            "Fuisic\\Auth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fuisic\\Auth\\FuisicAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
